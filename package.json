{
  "name": "lead-enrichment",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts --serve",
    "build": "tsc",
    "start": "node dist/index.js --serve",
    "start:pm2": "npm run build && NODE_ENV=production pm2 start dist/index.js --name lead-enrichment -- --serve && pm2 save",
    "test": "node --test --require ts-node/register tests/*.test.ts",
    "benchmark": "ts-node scripts/benchmark.ts"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/multer": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
